{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff 'UTC' ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Extract": {
    "IntervalMinutes": 1,
    "OutputPath": "reports"
  }
}
